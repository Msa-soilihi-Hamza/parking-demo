    "db:seed:neon": "tsx --env-file=.env.neon src/db/seed.ts",
    "smoke:neon": "tsx --env-file=.env.neon scripts/smoke-test.ts",
    "webhook:check": "tsx scripts/webhook-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@vercel/functions": "^3.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
