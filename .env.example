# Base PostgreSQL lancée par docker-compose (identifiants de développement uniquement)
DATABASE_URL=postgres://escale:escale@localhost:5434/escale

# URL publique de l'application (liens de retour Stripe et lien dans les e-mails)
APP_URL=http://localhost:3100

# Stripe, MODE TEST uniquement : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Affiché par `stripe listen --forward-to localhost:3100/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Gmail SMTP pour les codes de vérification et les confirmations.
# Mot de passe d'application : https://myaccount.google.com/apppasswords (double authentification requise)
GMAIL_USER=votre.adresse@gmail.com
GMAIL_APP_PASSWORD=

# Notifications push de l'équipe navette (Web Push, gratuit).
# Générer une paire : node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:votre.adresse@gmail.com

# Code d'accès à la page Navette
SHUTTLE_ACCESS_CODE=navette
